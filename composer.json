{
    "name": "zerofront/module-zero-blog",
    "description": "Zero for Magento Open Source: a blog: posts written in the Zero CMS editor, categories, tags, authors, products in posts, comments.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "blog"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-customer": "*",
        "magento/module-sitemap": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*",
        "magento/module-url-rewrite": "*",
        "zerofront/module-zero-core": "^1.3",
        "zerofront/module-zero-banner": "^1.3",
        "zerofront/module-zero-cms": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-blog": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\Blog\\": ""
        }
    }
}
